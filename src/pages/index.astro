---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/sections/Hero.astro";
import SobreNosotros from "../components/sections/SobreNosotros.astro";
import Ubicacion from "../components/sections/Ubicacion.astro";
import Pinchos from "../components/sections/Pinchos.astro";
import Premios from "../components/sections/Premios.astro";
import NuestroBar from "../components/sections/NuestroBar.astro";
---

<Layout>
  <Hero />
  <SobreNosotros />
  <Pinchos />
  <Premios />
  <NuestroBar />
  <Ubicacion />
</Layout>
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const tl_hero = gsap.timeline({
    duration: 0.6,
  });

  tl_hero
    .from(".titulo", {
      x: -100,
      opacity: 0,
      duration: 1,
    })
    .from(".btn-hero", {
      opacity: 0,
      duration: 1,
    })
    .from(
      ".supratitulo",
      {
        opacity: 0,
        duration: 1,
      },
      "<",
    );

  gsap.from(".dato-ubicacion", {
    scrollTrigger: {
      trigger: "[data-location-section]",
      start: "top 80%",
    },
    x: -100,
    opacity: 0,
    stagger: 0.15,
  });
</script>
