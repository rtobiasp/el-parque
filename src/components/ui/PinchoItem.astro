---
import Image from "astro/components/Image.astro";

const { title, img } = Astro.props;
---

<article
  class="pincho-card group relative overflow-hidden rounded-3xl bg-brand-black"
>
  <div class="pincho-card-image aspect-[16/10] overflow-hidden">
    <Image
      src={img}
      alt={"Imagen del pincho " + title}
      loading={"lazy"}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div
    class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-brand-black via-brand-black/80 to-transparent px-5 pb-5 pt-16 text-brand-white"
  >
    <p
      class="mb-1 text-xs font-medium uppercase tracking-[0.2em] text-brand-accent"
    >
      Selección semanal
    </p>
    <h3 class="text-2xl leading-none">{title}</h3>
  </div>
</article>
