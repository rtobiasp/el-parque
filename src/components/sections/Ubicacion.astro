---
import Image from "astro/components/Image.astro";
import icon_phone from "../../assets/icon-phone.png";
import icon_location from "../../assets/icon-location.png";
import icon_clock from "../../assets/icon-clock.png";
---

<section
  id="ubicacion"
  data-location-section
  class="section-shell flex flex-col gap-8 overflow-hidden bg-brand-white px-6 py-12 md:px-20"
>
  <div class="flex items-center gap-3 sm:gap-4">
    <h2 class="min-w-0 text-lg font-medium uppercase leading-tight sm:text-2xl">
      Dónde encontrarnos
    </h2>
    <div class="border-b flex-1"></div>
  </div>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[40%_60%]">
    <div class="flex flex-col gap-6 lg:pr-8">
      <div class="dato-ubicacion flex flex-row gap-2 items-center">
        <Image src={icon_location} alt="" width={22} class="h-6/12" />
        <p class="text-base leading-relaxed">
          C. Artesanos, 10, 26006 <br /> Varea, La Rioja
        </p>
      </div>
      <div class="dato-ubicacion flex flex-row gap-2 items-center">
        <Image src={icon_phone} alt="" width={22} height={22} />
        <a
          href="tel:+34941395127"
          aria-label="Llamar al 941 395 127"
          class="font-medium text-brand-primary underline decoration-transparent underline-offset-4 transition-colors hover:decoration-current focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          941 395 127
        </a>
      </div>
      <div class="dato-ubicacion flex flex-col gap-3">
        <div class="flex flex-row gap-2">
          <Image src={icon_clock} alt="" width={22} height={22} />
          <p class="font-medium">Horarios:</p>
        </div>
        <div>
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4">
            <strong>Lunes</strong>
            <p class="m-0 text-right">08:00 - 23:00</p>
          </div>
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4">
            <strong>Martes</strong>
            <p class="m-0 text-right">08:00 - 23:00</p>
          </div>
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4">
            <strong>Miércoles</strong>
            <p class="m-0 text-right">08:00 - 23:00</p>
          </div>
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4">
            <strong>Jueves</strong>
            <p class="m-0 text-right">08:00 - 23:00</p>
          </div>
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4">
            <strong>Viernes</strong>
            <p class="m-0 text-right">08:00 - 24:00</p>
          </div>
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4">
            <strong>Sábado</strong>
            <p class="m-0 text-right">08:00 - 24:00</p>
          </div>
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-4">
            <strong>Domingo</strong>
            <p class="m-0 text-right">Cerrado</p>
          </div>
        </div>
      </div>
    </div>

    <div
      class="iframe-ubicacion aspect-[4/3] min-h-0 w-full overflow-hidden md:aspect-video"
    >
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2943.4043453983777!2d-2.4114154161891417!3d42.461688254389074!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd5aab9153851001%3A0xce977d540bed5624!2sCafeteria%20El%20Parque!5e0!3m2!1ses!2ses!4v1788512407507!5m2!1ses!2ses"
        title="Mapa de ubicación de El Parque"
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        class="h-full w-full"></iframe>
    </div>
  </div>
</section>
