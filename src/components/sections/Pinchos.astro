---
import PinchoItem from "../ui/PinchoItem.astro";
import pinchoTortilla from "../../assets/pincho-tortilla.jpg";
import pinchoBravas from "../../assets/pincho-bravas.jpg";
import pinchoGilda from "../../assets/pincho-gilda.jpg";
import iconFlecha from "../../assets/icon-flecha.png";
---

<section
  id="pinchos"
  class="section-shell pinchos-section relative isolate flex flex-col justify-center gap-8 overflow-hidden rounded-t-4xl bg-brand-primary px-6 py-12 text-brand-white md:px-20"
>
  <div class="titulo-pinchos relative z-10">
    <h2 class="max-w-3xl text-4xl leading-tight md:text-5xl lg:text-6xl">
      Los jueves saben a
      <span class="italic text-brand-accent"> Pincho-Pote </span>
    </h2>
  </div>
  <div
    class="pinchos relative z-10 grid min-h-0 grid-cols-1 items-center gap-8 lg:grid-cols-[1.35fr_3fr]"
  >
    <div class="info-pinchos min-w-0 max-w-xl text-brand-white/80">
      <p
        class="m-0 text-base leading-7 md:text-lg md:leading-8 lg:text-xl lg:leading-9"
      >
        Los jueves a partir de las 20:00 la barra se llena de sabor. Descubre
        algunos clásicos del pincho-pote y acompáñalos con tu consumición. La
        selección puede variar según disponibilidad.
      </p>
    </div>
    <div class="pincho-slider-wrap relative min-w-0 w-full">
      <div
        class="swiper swiper-container relative w-full overflow-hidden rounded-3xl"
        aria-label="Selección de pinchos"
      >
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <PinchoItem
              title="Tortilla de patata"
              description="Patata, huevo y cebolla: un clásico jugoso para empezar."
              img={pinchoTortilla}
            />
          </div>
          <div class="swiper-slide">
            <PinchoItem
              title="Patatas bravas"
              description="Patata dorada y salsa brava, con el punto justo de picante."
              img={pinchoBravas}
            />
          </div>
          <div class="swiper-slide">
            <PinchoItem
              title="Gilda"
              description="La combinación vasca de anchoa, aceituna y piparra."
              img={pinchoGilda}
            />
          </div>
        </div>
      </div>
      <div class="mt-5 flex items-center justify-between gap-4">
        <div class="swiper-pagination"></div>
        <div class="flex gap-2">
          <button
            class="swiper-button-prev-custom"
            type="button"
            aria-label="Pincho anterior"
          >
            <img
              class="arrow-icon arrow-icon-prev"
              src={iconFlecha.src}
              alt=""
            />
          </button>
          <button
            class="swiper-button-next-custom"
            type="button"
            aria-label="Siguiente pincho"
          >
            <img class="arrow-icon" src={iconFlecha.src} alt="" />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Autoplay, Navigation, Pagination } from "swiper/modules";
  import "swiper/css";

  new Swiper(".swiper", {
    modules: [Autoplay, Navigation, Pagination],
    loop: true,
    grabCursor: true,
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
    },
    spaceBetween: 16,
    slidesPerView: 1.25,
    breakpoints: {
      640: {
        slidesPerView: 2,
      },
      1024: {
        slidesPerView: 1.5,
      },
    },
    navigation: {
      nextEl: ".swiper-button-next-custom",
      prevEl: ".swiper-button-prev-custom",
    },
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
  });
</script>

<style>
  .info-pinchos {
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.8);
  }

  .info-pinchos p {
    max-width: 26rem;
    text-wrap: pretty;
  }

  .pincho-slider-wrap {
    padding-bottom: 0.25rem;
  }

  .swiper-pagination {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    position: static !important;
    width: auto !important;
  }

  :global(.swiper-pagination-bullet) {
    width: 0.45rem;
    height: 0.45rem;
    margin: 0 !important;
    background: rgba(242, 247, 248, 0.5);
    opacity: 1;
    transition:
      width 200ms ease,
      background-color 200ms ease;
  }

  :global(.swiper-pagination-bullet-active) {
    width: 1.5rem;
    border-radius: 999px;
    background: var(--color-brand-accent);
  }

  .swiper-button-prev-custom,
  .swiper-button-next-custom {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgba(242, 247, 248, 0.35);
    border-radius: 999px;
    cursor: pointer;
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      transform 200ms ease;
  }

  .arrow-icon {
    width: 1rem;
    height: 1rem;
    object-fit: contain;
    filter: brightness(0) invert(1);
    transition:
      transform 200ms ease,
      filter 200ms ease;
  }

  .arrow-icon-prev {
    transform: rotate(180deg);
  }

  .swiper-button-prev-custom:hover,
  .swiper-button-next-custom:hover,
  .swiper-button-prev-custom:focus-visible,
  .swiper-button-next-custom:focus-visible {
    border-color: var(--color-brand-accent);
    background: var(--color-brand-accent);
    transform: translateY(-2px);
  }

  .swiper-button-prev-custom:hover .arrow-icon,
  .swiper-button-prev-custom:focus-visible .arrow-icon,
  .swiper-button-next-custom:hover .arrow-icon,
  .swiper-button-next-custom:focus-visible .arrow-icon {
    filter: brightness(0);
    transform: scale(1.15);
  }

  .swiper-button-prev-custom:hover .arrow-icon-prev,
  .swiper-button-prev-custom:focus-visible .arrow-icon-prev {
    transform: rotate(180deg) scale(1.15);
  }
</style>
