---
import PinchoItem from "../ui/PinchoItem.astro";
import pincho_individual from "../../assets/pincho_individual.png";
---

<section
  id="pinchos"
  class="section-shell pinchos-section relative isolate flex flex-col justify-center gap-8 overflow-hidden rounded-t-4xl bg-brand-primary px-6 py-12 text-brand-white md:px-20"
>
  <div class="titulo-pinchos relative z-10">
    <h2 class="max-w-3xl text-4xl leading-tight md:text-5xl lg:text-6xl">
      Los jueves saben a
      <span class="italic text-brand-accent"> Pincho-Pote </span>
    </h2>
  </div>
  <div
    class="pinchos relative z-10 grid min-h-0 grid-cols-1 items-center gap-8 lg:grid-cols-[1.5fr_3fr]"
  >
    <div class="info-pinchos min-w-0 max-w-xl text-brand-white/80">
      <p
        class="m-0 text-base leading-7 md:text-lg md:leading-8 lg:text-xl lg:leading-9"
      >
        Los jueves a partir de las 20:00 la barra se llena de sabor. Elige tu
        pincho favorito de nuestra selección semanal y acompáñalo con tu
        consumición al mejor precio. El plan perfecto para desconectar y empezar
        a saborear el fin de semana.
      </p>
    </div>
    <div
      class="swiper swiper-container relative min-w-0 w-full rounded-tl-4xl rounded-bl-4xl"
    >
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <PinchoItem title="Tortilla" img={pincho_individual} />
        </div>
        <div class="swiper-slide">
          <PinchoItem title="Kebab" img={pincho_individual} />
        </div>
        <div class="swiper-slide">
          <PinchoItem title="TEST" img={pincho_individual} />
        </div>
        <div class="swiper-slide">
          <PinchoItem title="TEST" img={pincho_individual} />
        </div>
        <div class="swiper-slide">
          <PinchoItem title="TEST" img={pincho_individual} />
        </div>
        <div class="swiper-slide">
          <PinchoItem title="TEST" img={pincho_individual} />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";
  import "swiper/css";

  new Swiper(".swiper", {
    modules: [Autoplay],
    loop: true,
    grabCursor: true,
    autoplay: {
      delay: 3000,
      disableOnInteraction: false,
    },
    spaceBetween: 16,
    slidesPerView: 3,
    breakpoints: {
      640: {
        slidesPerView: 2,
      },
      1024: {
        slidesPerView: 1.75,
      },
    },
  });
</script>

<style>
  .info-pinchos {
    display: flex;
    align-items: center;
    color: rgba(255, 255, 255, 0.8);
  }

  .info-pinchos p {
    max-width: 26rem;
    text-wrap: pretty;
  }
</style>
