---
import Button from "../ui/Button.astro";
---

<section class="relative min-h-[100svh] overflow-hidden px-6 md:px-20">
  <div id="bg-layer" class="absolute inset-0"></div>
  <div class="relative z-10 flex min-h-[100svh] items-start justify-center pt-36 text-center md:items-center md:justify-start md:pt-28 md:text-left">
    <div class="mx-auto w-full max-w-2xl md:mx-0">
      <div class="mb-5">
        <p
          class="supratitulo text-sm uppercase tracking-[0.25em] text-brand-white/80"
        >
          Bar El Parque
        </p>
      </div>
      <div>
        <h1
          class="titulo mx-auto max-w-3xl text-4xl leading-[1.08] text-brand-white sm:text-5xl md:mx-0 md:text-7xl"
        >
          El arte del buen café, servido cada mañana
        </h1>
      </div>
    </div>
  </div>
</section>

<script></script>

<style>
  #bg-layer {
    background-image:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.5),
        rgba(0, 0, 0, 0.22) 55%,
        rgba(0, 0, 0, 0.08)
      ),
      url("../../assets/banner_v3.png");
    background-repeat: no-repeat;
    /* En móvil la taza está a la derecha de la imagen: desplazamos
       el encuadre para que el café quede centrado y algo más abajo,
       dejando hueco arriba para el texto. */
    background-position: 72% 60%;
    background-size: cover;
  }

  @media (min-width: 768px) {
    #bg-layer {
      background-position: center;
    }
  }

  .titulo {
    text-shadow: 0 3px 14px rgba(0, 0, 0, 0.65);
  }

  .supratitulo {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }
</style>
