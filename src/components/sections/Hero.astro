---
import Button from "../ui/Button.astro";
---

<section class="relative min-h-screen overflow-hidden px-6 md:px-20">
  <div id="bg-layer" class="absolute inset-0 min-h-screen"></div>
  <div class="relative z-10 flex min-h-screen items-center">
    <div class="max-w-2xl">
      <div class="mb-5">
        <p
          class="supratitulo text-sm uppercase tracking-[0.25em] text-brand-white/80"
        >
          Bar El Parque
        </p>
      </div>
      <div>
        <h1
          class="titulo max-w-3xl text-4xl leading-[1.08] text-brand-white sm:text-5xl md:text-7xl"
        >
          El arte del buen café, servido cada mañana
        </h1>
      </div>
    </div>
  </div>
</section>

<script></script>

<style>
  #bg-layer {
    background-image:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.5),
        rgba(0, 0, 0, 0.22) 55%,
        rgba(0, 0, 0, 0.08)
      ),
      url("../../assets/banner_v3.png");
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }

  .titulo {
    text-shadow: 0 3px 14px rgba(0, 0, 0, 0.65);
  }

  .supratitulo {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
  }
</style>
