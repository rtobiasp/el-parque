---
import Image from "astro/components/Image.astro";
import logo from "../assets/logo.png";
---

<div class="bg-brand-black px-6 py-14 text-brand-white md:px-20 md:py-16">
  <div class="mx-auto max-w-7xl">
    <div
      class="grid gap-12 border-b border-brand-white/20 pb-12 md:grid-cols-[1.5fr_1fr_1.2fr] md:gap-16"
    >
      <div class="flex flex-col items-center gap-5 md:items-start">
        <a
          href="/"
          aria-label="Volver al inicio de El Parque"
          class="flex justify-center md:justify-start"
        >
          <Image src={logo} alt="El Parque" width={280} class="w-42 md:w-70" />
        </a>
      </div>

      <nav aria-label="Navegación del pie de página">
        <h2
          class="mb-5 text-sm font-semibold uppercase tracking-[0.18em] text-brand-accent"
        >
          Explora
        </h2>
        <ul class="flex flex-col items-start gap-3 text-sm">
          <li><a class="footer-link" href="/">Inicio</a></li>
          <li>
            <a class="footer-link" href="#ubicacion">Dónde encontrarnos</a>
          </li>
          <li><a class="footer-link" href="#pinchos">Nuestros pinchos</a></li>
          <li>
            <a class="footer-link" href="#nuestro-bar">Nuestro bar</a>
          </li>
        </ul>
      </nav>

      <div>
        <h2
          class="mb-5 text-sm font-semibold uppercase tracking-[0.18em] text-brand-accent"
        >
          Ven a vernos
        </h2>
        <address
          class="flex flex-col gap-3 text-sm not-italic text-brand-white/80"
        >
          <p>C. Artesanos, 10<br />26006 Varea, La Rioja</p>
          <a class="footer-link w-fit" href="tel:+34941395127">941 395 127</a>
          <p>Lun - Jue · 08:00 - 23:00<br />Vie - Sáb · 08:00 - 24:00</p>
        </address>
      </div>
    </div>

    <div
      class="flex flex-col gap-3 pt-6 text-xs text-brand-white/50 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {new Date().getFullYear()} Bar El Parque</p>
      <p>Varea, La Rioja</p>
    </div>
  </div>
</div>

<style>
  .footer-link {
    color: color-mix(in srgb, var(--color-brand-white) 80%, transparent);
    transition: color 180ms ease;
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-brand-accent);
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 4px;
  }
</style>
