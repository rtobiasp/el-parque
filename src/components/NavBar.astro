---
import Image from "astro/components/Image.astro";
import logo from "../assets/logo.png";
---

<nav
  class="navbar flex h-24 flex-row items-center justify-center overflow-hidden px-4 sm:px-8 md:h-32 md:px-20"
>
  <div>
    <a href="/">
      <Image
        class="navbar-logo"
        src={logo}
        alt="Logotipo del sitio"
        width={200}
      />
    </a>
  </div>
</nav>

<script>
  const navbar = document.querySelector(".navbar");

  const updateNavbar = () => {
    navbar?.classList.toggle("navbar-scrolled", window.scrollY > 0);
  };

  updateNavbar();
  window.addEventListener("scroll", updateNavbar, { passive: true });
</script>

<style>
  .navbar {
    transition:
      height 180ms ease,
      background-color 180ms ease;
  }

  .navbar-logo {
    width: min(200px, 58vw);
    max-height: calc(100% - 1rem);
    object-fit: contain;
    transition: width 180ms ease;
  }

  .navbar-scrolled {
    height: 4.5rem;
    background-color: color-mix(
      in srgb,
      var(--color-brand-primary) 95%,
      transparent
    );
  }

  .navbar-scrolled .navbar-logo {
    width: min(150px, 46vw);
    max-height: calc(100% - 1rem);
  }

  @media (max-width: 767px) {
    .navbar-logo {
      width: min(120px, 48vw);
    }

    .navbar-scrolled .navbar-logo {
      width: min(80px, 32vw);
    }
  }

  @media (min-width: 768px) {
    .navbar-scrolled {
      height: 5.5rem;
    }
  }
</style>
