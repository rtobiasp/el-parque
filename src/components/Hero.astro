---
import Button from "./Button.astro";
---

<section class="relative min-h-screen overflow-hidden">
  <div id="bg-layer" class="absolute inset-0 min-h-screen"></div>
  <div class="relative z-10 flex min-h-screen items-center px-6 md:px-20">
    <div class="max-w-2xl">
      <div class="mb-5">
        <p
          class="text-sm uppercase tracking-[0.25em] text-brand-white/80"
        >
          Bar El Parque · Cada mañana
        </p>
      </div>
      <div>
        <h1 class="max-w-3xl text-5xl leading-[1.05] text-brand-white md:text-7xl">
          El arte del buen café, servido cada mañana
        </h1>
      </div>
      <div class="mt-8">
        <Button link="mailto:test@elparque.com" text="Contacta con nosotros" />
      </div>
    </div>
  </div>
</section>

<style>
  #bg-layer {
    background-image:
      linear-gradient(90deg, rgba(11, 30, 34, 0.85), rgba(11, 30, 34, 0.2)),
      url("../assets/banner.jpg");
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }
</style>
