---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import Footer from "../components/Footer.astro";

const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, "");
const canonicalUrl = siteUrl ? `${siteUrl}${Astro.url.pathname}` : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Bar El Parque, en Varea, La Rioja. Café, pinchos y buen ambiente de barrio."
    />
    <meta name="theme-color" content="#15616A" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content="El Parque | Bar de barrio" />
    <meta
      property="og:description"
      content="Café, pinchos y buen ambiente de barrio en Varea, La Rioja."
    />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>El Parque | Bar de barrio</title>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-brand-accent focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-brand-black"
    >
      Saltar al contenido principal
    </a>
    <header class="fixed w-screen top-0 z-50 bg-transparent">
      <NavBar />
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <Footer />
    </footer>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  :focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 4px;
  }
</style>
